{
  "listen_port": 8080,
  "listen_host": "0.0.0.0",
  "need_auth": true,
  "enable_api_when_start": false,
  "debug_mode": true,
  "token_file_path": "./config/token.txt",
  "subs_configs": [
    {
      "tag": "default",
      "file_path": "/etc/subs/default.yaml",
      "comment": "默认订阅配置"
    },
    {
      "tag": "backup",
      "file_path": "/etc/subs/backup.yaml",
      "comment": "备用订阅配置"
    }
  ]
}
